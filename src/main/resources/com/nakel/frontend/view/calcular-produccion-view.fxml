<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Tres bloques: 1) qué se fabrica, 2) con qué (receta), 3) a cuánto se vende (panel de la derecha) -->
<VBox spacing="16" styleClass="modulo-container"
      stylesheets="@../../../../css/nakel.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nakel.frontend.controller.CalculadoraController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Calculadora de Producción" styleClass="titulo-modulo"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- ================= IZQUIERDA: producto + receta ================= -->
        <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="480">

            <HBox spacing="14" alignment="CENTER_LEFT" styleClass="tarjeta">
                <Label text="1. Nombre del producto" styleClass="titulo-tarjeta" minWidth="-Infinity"/>
                <!-- Campo alto y con fondo gris: es lo primero que hay que llenar y tiene que verse rápido -->
                <TextField fx:id="txtNombreProducto" promptText="Ej: Mochila Matera Negra"
                           styleClass="text-field, campo-destacado" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

            <VBox spacing="12" styleClass="tarjeta" VBox.vgrow="ALWAYS">
                <Label text="2. Insumos y mano de obra" styleClass="titulo-tarjeta"/>

                <!-- Buscador + páginas de la lista de insumos -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscarInsumo" promptText="Buscar insumo o servicio... (F3)"
                               styleClass="input-busqueda" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btnPaginaAnterior" text="‹" onAction="#paginaAnterior" styleClass="btn-secundario" minWidth="40" style="-fx-padding: 6 12;"/>
                    <Label fx:id="lblPaginaInsumos" text="Página 1 de 1" styleClass="dato-ayuda" minWidth="-Infinity"/>
                    <Button fx:id="btnPaginaSiguiente" text="›" onAction="#paginaSiguiente" styleClass="btn-secundario" minWidth="40" style="-fx-padding: 6 12;"/>
                </HBox>

                <!-- Lista de insumos: primero horas, después unidades, después metros.
                     "Disponible" ya descuenta lo que está cargado en la receta de abajo (solo en pantalla). -->
                <TableView fx:id="tablaInsumos" styleClass="tabla-compacta" minHeight="130" prefHeight="200" maxHeight="240">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colInsNombre" text="Insumo o Servicio" prefWidth="280"/>
                        <TableColumn fx:id="colInsUnidad" text="Se mide en" prefWidth="100" sortable="false"/>
                        <TableColumn fx:id="colInsDisponible" text="Disponible" prefWidth="140" sortable="false"/>
                        <TableColumn fx:id="colInsCosto" text="Costo unitario" minWidth="140" prefWidth="150" sortable="false"/>
                    </columns>
                </TableView>

                <HBox spacing="12" alignment="BOTTOM_LEFT" minHeight="62">
                    <VBox spacing="2" alignment="BOTTOM_LEFT" maxHeight="Infinity" minWidth="170" HBox.hgrow="SOMETIMES">
                        <Label fx:id="lblAyudaMedida" text="Elegí un insumo de la lista para cargar la medida o la cantidad."
                               styleClass="dato-ayuda" wrapText="true"/>
                        <Label fx:id="lblInsumoElegido" style="-fx-font-weight: bold; -fx-font-size: 14px;" wrapText="true"/>
                        <Label fx:id="lblStock" styleClass="dato-ayuda"/>
                    </VBox>

                    <!-- Solo para insumos que se miden por superficie (cuero, tela...) -->
                    <HBox fx:id="boxSuperficie" spacing="10" alignment="BOTTOM_LEFT" visible="false" managed="false">
                        <VBox spacing="4">
                            <Label text="Ancho (cm)" styleClass="etiqueta-campo"/>
                            <TextField fx:id="txtAncho" promptText="0" prefWidth="110" styleClass="text-field" onAction="#agregarInsumoAReceta"/>
                        </VBox>
                        <Label text="×" style="-fx-font-size: 18px; -fx-padding: 0 0 8 0;"/>
                        <VBox spacing="4">
                            <Label text="Largo (cm)" styleClass="etiqueta-campo"/>
                            <TextField fx:id="txtLargo" promptText="0" prefWidth="110" styleClass="text-field" onAction="#agregarInsumoAReceta"/>
                        </VBox>
                    </HBox>

                    <!-- Para insumos por unidad o servicios por hora -->
                    <VBox fx:id="boxCantidad" spacing="4" visible="false" managed="false">
                        <Label fx:id="lblCantidad" text="Cantidad" styleClass="etiqueta-campo"/>
                        <TextField fx:id="txtCantidad" promptText="0" prefWidth="140" styleClass="text-field" onAction="#agregarInsumoAReceta"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Agregar a la receta" onAction="#agregarInsumoAReceta" styleClass="btn-secundario"/>
                </HBox>

                <Label text="Receta del producto" styleClass="etiqueta-formulario"/>
                <TableView fx:id="tablaReceta" styleClass="tabla-compacta" VBox.vgrow="ALWAYS" minHeight="110" prefHeight="200">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colInsumo" text="Insumo o Servicio" prefWidth="300"/>
                        <TableColumn fx:id="colUso" text="Medida / Uso" prefWidth="200"/>
                        <TableColumn fx:id="colSubtotal" minWidth="115" text="Costo" prefWidth="140"/>
                        <TableColumn fx:id="colQuitar" text="Quitar" minWidth="70" maxWidth="80" prefWidth="70" sortable="false"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>

        <!-- ================= DERECHA: precio ================= -->
        <VBox spacing="14" styleClass="tarjeta" minWidth="300" prefWidth="320" maxWidth="340">
            <Label text="3. Precio" styleClass="titulo-tarjeta"/>

            <VBox spacing="2">
                <Label text="Costo total de producción" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                <Label fx:id="lblTotalCosto" text="\$ 0,00" styleClass="dato-importe"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Margen de ganancia (%)" styleClass="etiqueta-campo"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtMargen" promptText="Ej: 50" prefWidth="100" styleClass="text-field"/>
                    <Label text="Sugerido: más de 21%" style="-fx-font-size: 13px; -fx-text-fill: #F2994A;"/>
                </HBox>
            </VBox>

            <VBox spacing="2">
                <Label text="Ganancia" styleClass="etiqueta-campo"/>
                <Label fx:id="lblGanancia" text="\$ 0,00" styleClass="dato-importe"/>
            </VBox>

            <Separator/>

            <VBox spacing="2">
                <Label text="Precio de venta sugerido" styleClass="etiqueta-campo"/>
                <Label fx:id="lblPrecioFinal" text="\$ 0,00" styleClass="label-total-numero" style="-fx-text-fill: #2E9E6B;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Crear producto y fabricar" styleClass="btn-primario" onAction="#guardarPresupuesto"
                    maxWidth="Infinity" prefHeight="50"/>
        </VBox>
    </HBox>

</VBox>
