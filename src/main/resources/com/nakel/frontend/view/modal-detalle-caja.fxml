<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="980.0" prefHeight="680.0" spacing="12.0" styleClass="modulo-container" stylesheets="@../../../../css/nakel.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nakel.frontend.controller.ModalDetalleCajaController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label fx:id="lblTitulo" styleClass="titulo-modulo" text="Detalle de Caja" />

    <!-- Resumen: a la izquierda los datos de la caja, a la derecha con qué se cobró -->
    <HBox spacing="40.0">
        <GridPane hgap="12" vgap="6">
            <Label text="Apertura:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="lblFechaApertura" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Cierre:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="lblFechaCierre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Estado:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="lblEstado" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Total de ventas:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Label fx:id="lblTotalVentas" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Egresos:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label fx:id="lblEgresos" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Saldo final:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <Label fx:id="lblSaldoFinal" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        </GridPane>

        <GridPane hgap="12" vgap="6">
            <Label text="Efectivo:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="lblEfectivo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Transferencias:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="lblTransferencias" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="MercadoPago:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="lblMercadoPago" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Tarjeta de débito:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Label fx:id="lblDebito" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Tarjeta de crédito:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label fx:id="lblCredito" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Pagado con vales:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <Label fx:id="lblVales" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        </GridPane>
    </HBox>

    <Label styleClass="etiqueta-formulario" text="Movimientos del día" />

    <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS" styleClass="tabla-estandar">
        <columns>
            <TableColumn fx:id="colHora" prefWidth="70.0" text="Hora" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colTipo" prefWidth="110.0" text="Tipo" />
            <TableColumn fx:id="colConcepto" prefWidth="190.0" text="Concepto" />
            <TableColumn fx:id="colDetalle" prefWidth="330.0" text="Detalle" />
            <TableColumn fx:id="colMedio" prefWidth="130.0" text="Medio de pago" />
            <TableColumn fx:id="colMonto" minWidth="115" prefWidth="120.0" text="Monto" style="-fx-alignment: CENTER-RIGHT;" />
        </columns>
        <!-- Las columnas se reparten el ancho de la ventana: sin barra de desplazamiento horizontal -->
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#cerrarModal" styleClass="btn-secundario" text="Cerrar" />
    </HBox>
</VBox>
