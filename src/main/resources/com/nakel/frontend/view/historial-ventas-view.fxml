<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" styleClass="modulo-container"
      stylesheets="@../../../../css/nakel.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nakel.frontend.controller.HistorialVentasController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Historial de Comprobantes y Ventas" styleClass="titulo-modulo"/>
        <Pane HBox.hgrow="ALWAYS" />
        <Button text="NUEVA VENTA (POS)" styleClass="btn-primario" onAction="#abrirPuntoDeVenta"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <ComboBox fx:id="cmbMes" promptText="Mes actual" styleClass="text-field"/>

        <!-- 🔥 NUEVO 1: Selector de tipo de búsqueda -->
        <ComboBox fx:id="cmbCampoBusqueda" styleClass="text-field" prefWidth="180"/>

        <TextField fx:id="txtBuscarVenta" promptText="Escriba aquí..." HBox.hgrow="ALWAYS" styleClass="input-busqueda"/>

        <Button text="Filtrar (F3)" styleClass="btn-secundario" onAction="#buscarVenta"/>

        <Button text="Limpiar" styleClass="btn-azul" onAction="#limpiarBusqueda"/>
    </HBox>

    <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS" styleClass="tabla-estandar">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150"/>
            <TableColumn fx:id="colNro" text="Punto Venta - Nro" prefWidth="130"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
            <TableColumn fx:id="colTotal" minWidth="115" text="Total" prefWidth="100"/>
            <TableColumn fx:id="colEstado" text="Estado AFIP" prefWidth="120"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="200"/>
        </columns>
    </TableView>
    <!-- 🔥 EL NUEVO PAGINADOR NATIVO DE JAVAFX -->
    <Pagination fx:id="paginadorHistorial" pageCount="1" currentPageIndex="0" VBox.vgrow="NEVER" styleClass="paginador-estandar"/>

    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 10 0 0 0;">
        <!-- Es el total de TODAS las ventas que cumplen el filtro (todas las páginas), sin contar presupuestos -->
        <Label fx:id="lblCantidadVentas" text="Cantidad de comprobantes: 0" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <Label text="Total facturado:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <Label fx:id="lblTotalFacturado" text="\$ 0,00" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
    </HBox>

</VBox>