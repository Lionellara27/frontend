<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Configuración: título como el resto de las pantallas y las pestañas ocupando todo el alto -->
<VBox spacing="10" styleClass="modulo-container"
      stylesheets="@../../../../css/nakel.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nakel.frontend.controller.ConfiguracionController">
    <padding>
        <Insets top="20" right="20" bottom="14" left="20"/>
    </padding>

    <Label text="Configuración" styleClass="titulo-modulo"/>

    <TabPane fx:id="tabPaneConfig" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="pestanas-configuracion">
        <tabs>
            <Tab text="Precios y Dólar">
                <graphic>
                    <FontIcon iconLiteral="fas-dollar-sign" />
                </graphic>
                <content>
                    <fx:include source="tab_divisas.fxml" />
                </content>
            </Tab>

            <Tab text="Categorías y Materiales">
                <graphic>
                    <FontIcon iconLiteral="fas-boxes" />
                </graphic>
                <content>
                    <fx:include source="tab_parametros.fxml" />
                </content>
            </Tab>

            <Tab text="Vales">
                <graphic>
                    <FontIcon iconLiteral="fas-ticket-alt" />
                </graphic>
                <content>
                    <fx:include source="tab_vales.fxml" />
                </content>
            </Tab>

            <Tab text="Usuario y Contraseña">
                <graphic>
                    <FontIcon iconLiteral="fas-lock" />
                </graphic>
                <content>
                    <fx:include source="tab_seguridad.fxml" />
                </content>
            </Tab>

            <Tab text="Copias de seguridad">
                <graphic>
                    <FontIcon iconLiteral="fas-shield-alt" />
                </graphic>
                <content>
                    <fx:include source="tab_copias.fxml" />
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
