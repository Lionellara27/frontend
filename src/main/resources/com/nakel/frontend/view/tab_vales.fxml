<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Pestaña "Vales" de Configuración: emitir un vale a un cliente y ver todos los vales del sistema -->
<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="450.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nakel.frontend.controller.TabValesController">
    <children>
        <Label text="Un vale es plata a favor de un cliente para gastar en el local. Acá podés regalarle uno a un cliente y ver todos los vales que hay dando vueltas."
               styleClass="descripcion-pestana" wrapText="true" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="14.0" />
        <HBox spacing="24.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="48.0">
            <padding>
                <Insets top="5" />
            </padding>

            <!-- IZQUIERDA: emitir un vale -->
            <VBox spacing="10.0" minWidth="330.0" prefWidth="350.0" maxWidth="380.0">
                <Label text="Emitir un vale" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #155643;" />
                <Label wrapText="true" style="-fx-text-fill: #555555;"
                       text="El vale queda como saldo a favor del cliente. Sirve para una atención, una compensación o un regalo." />

                <Label text="1. ¿Para qué cliente?" styleClass="etiqueta-formulario" />
                <HBox spacing="8.0">
                    <TextField fx:id="txtBuscarCliente" promptText="Nombre o DNI..." styleClass="input-busqueda" HBox.hgrow="ALWAYS" />
                    <Button text="Cliente nuevo" styleClass="btn-azul" onAction="#abrirClienteNuevo" />
                </HBox>
                <ListView fx:id="listaClientes" prefHeight="130.0" minHeight="90.0" />
                <Label fx:id="lblClienteElegido" text="Todavía no elegiste un cliente" wrapText="true" style="-fx-font-weight: bold; -fx-text-fill: #B26A00;" />

                <Label text="2. ¿De cuánto es el vale?" styleClass="etiqueta-formulario" />
                <TextField fx:id="txtMonto" promptText="Ej: 5.000" styleClass="text-field" style="-fx-font-size: 16px;" />

                <Label text="3. Motivo (opcional)" styleClass="etiqueta-formulario" />
                <TextField fx:id="txtMotivo" promptText="Ej: atención por un inconveniente en el local" styleClass="text-field" />

                <Button fx:id="btnGenerar" text="Generar vale" styleClass="btn-primario" maxWidth="Infinity" onAction="#generarVale" />
            </VBox>

            <Separator orientation="VERTICAL" />

            <!-- DERECHA: todos los vales -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <Label text="Vales del sistema" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #155643;" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <CheckBox fx:id="chkSoloVigentes" text="Mostrar solo los vigentes" selected="true" />
                    <Button text="Actualizar" styleClass="btn-secundario" onAction="#recargar" />
                </HBox>

                <TableView fx:id="tablaVales" VBox.vgrow="ALWAYS" styleClass="tabla-estandar">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código" prefWidth="110.0" />
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="170.0" />
                        <TableColumn fx:id="colMonto" text="Saldo" prefWidth="110.0" minWidth="115" style="-fx-alignment: CENTER-RIGHT;" />
                        <TableColumn fx:id="colEmision" text="Emitido" prefWidth="100.0" />
                        <TableColumn fx:id="colVence" text="Vence" prefWidth="100.0" />
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="90.0" />
                        <TableColumn fx:id="colMotivo" text="Motivo" prefWidth="220.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Pagination fx:id="paginadorVales" pageCount="1" currentPageIndex="0" VBox.vgrow="NEVER" styleClass="paginador-estandar" />
            </VBox>
        </HBox>
    </children>
</AnchorPane>
