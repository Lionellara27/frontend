<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="14.0" vgap="14.0" stylesheets="@../../../../css/nakel.css" styleClass="formulario-dialogo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nakel.frontend.controller.ClienteExpressController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <columnConstraints>
        <ColumnConstraints halignment="RIGHT" minWidth="90.0" />
        <ColumnConstraints hgrow="ALWAYS" minWidth="280.0" />
    </columnConstraints>
    <children>
        <Label text="DNI / CUIT:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtDni" promptText="Ej: 20123456789" styleClass="input-busqueda" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nombre:" styleClass="etiqueta-formulario" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtNombre" promptText="Nombre y Apellido" styleClass="input-busqueda" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    </children>
</GridPane>
