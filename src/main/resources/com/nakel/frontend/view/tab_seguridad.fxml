<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Seguridad: primero "quién sos" (lo actual), después "lo nuevo" -->
<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background: #F8F9FA; -fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nakel.frontend.controller.TabSeguridadController">
    <HBox alignment="TOP_CENTER">
        <padding>
            <Insets top="14" right="20" bottom="14" left="20"/>
        </padding>

        <VBox spacing="9" styleClass="tarjeta" prefWidth="520" maxWidth="560">
            <Label text="Usuario y contraseña" styleClass="titulo-tarjeta"/>
            <Label text="Son los datos con los que se entra al sistema. Para cambiarlos, primero confirmá los que usás hoy."
                   styleClass="dato-ayuda" wrapText="true" minHeight="-Infinity"/>

            <!-- 1. Lo actual -->
            <Label text="1. Tus datos de hoy" styleClass="etiqueta-formulario"/>
            <GridPane hgap="10" vgap="7">
                <columnConstraints>
                    <ColumnConstraints minWidth="170" prefWidth="180"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="40" prefWidth="40" halignment="CENTER"/>
                </columnConstraints>

                <Label text="Usuario actual" styleClass="etiqueta-campo"/>
                <TextField fx:id="txtUsuarioActual" styleClass="text-field" GridPane.columnIndex="1"/>

                <Label text="Contraseña actual" styleClass="etiqueta-campo" GridPane.rowIndex="1"/>
                <StackPane GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <TextField fx:id="txtPassActualVisible" styleClass="text-field" visible="false"/>
                    <PasswordField fx:id="txtPassActual" styleClass="text-field"/>
                </StackPane>
                <ToggleButton fx:id="btnVerActual" text="" GridPane.columnIndex="2" GridPane.rowIndex="1"
                              style="-fx-cursor: hand; -fx-background-color: transparent;"/>
            </GridPane>

            <Separator/>

            <!-- 2. Lo nuevo -->
            <Label text="2. Cómo querés que queden" styleClass="etiqueta-formulario"/>
            <GridPane hgap="10" vgap="7">
                <columnConstraints>
                    <ColumnConstraints minWidth="170" prefWidth="180"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="40" prefWidth="40" halignment="CENTER"/>
                </columnConstraints>

                <Label text="Usuario" styleClass="etiqueta-campo"/>
                <TextField fx:id="txtNuevoUsuario" styleClass="text-field" GridPane.columnIndex="1"/>

                <Label text="Contraseña nueva" styleClass="etiqueta-campo" GridPane.rowIndex="1"/>
                <StackPane GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <TextField fx:id="txtPassNuevaVisible" styleClass="text-field" visible="false"/>
                    <PasswordField fx:id="txtPassNueva" styleClass="text-field"/>
                </StackPane>
                <ToggleButton fx:id="btnVerNueva" text="" GridPane.columnIndex="2" GridPane.rowIndex="1"
                              style="-fx-cursor: hand; -fx-background-color: transparent;"/>

                <Label text="Repetir contraseña nueva" styleClass="etiqueta-campo" GridPane.rowIndex="2"/>
                <StackPane GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <TextField fx:id="txtPassRepetirVisible" styleClass="text-field" visible="false"/>
                    <PasswordField fx:id="txtPassRepetir" styleClass="text-field"/>
                </StackPane>
                <ToggleButton fx:id="btnVerRepetir" text="" GridPane.columnIndex="2" GridPane.rowIndex="2"
                              style="-fx-cursor: hand; -fx-background-color: transparent;"/>
            </GridPane>
            <Label text="Si solo querés cambiar la contraseña, dejá el usuario como está." styleClass="dato-ayuda" wrapText="true" minHeight="-Infinity"/>

            <Region minHeight="2"/>
            <Button mnemonicParsing="false" onAction="#cambiarContrasena" styleClass="btn-primario"
                    text="Guardar cambios" maxWidth="Infinity" prefHeight="42"/>
        </VBox>
    </HBox>
</ScrollPane>
