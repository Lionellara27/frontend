<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nakel.frontend.controller.EstadisticasController">
    <children>
        <VBox layoutX="20.0" layoutY="20.0" prefHeight="560.0" prefWidth="860.0" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Resumen General" textFill="#333333">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <HBox spacing="20.0">
                    <children>
                        <VBox alignment="CENTER" prefHeight="120.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Ventas Hoy" textFill="#7f8c8d">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                                <Label fx:id="lblVentasHoy" text="/$ 0.00" textFill="#2c3e50">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Label fx:id="lblCantidadHoy" text="0 ventas" textFill="#95a5a6" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="120.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Ventas 7 Días" textFill="#7f8c8d">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                                <Label fx:id="lblVentasSemana" text="/$ 0.00" textFill="#2c3e50">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Label fx:id="lblCantidadSemana" text="0 ventas" textFill="#95a5a6" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="120.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Catálogo Activo" textFill="#7f8c8d">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                                <Label fx:id="lblTotalProductos" text="0" textFill="#2980b9">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Label text="Productos registrados" textFill="#95a5a6" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="120.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Stock Crítico" textFill="#7f8c8d">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                                <Label fx:id="lblStockCritico" text="0" textFill="#2c3e50">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Label text="Artículos por reponer" textFill="#95a5a6" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- TABLA DE STOCK CRITICO -->
                <AnchorPane prefHeight="350.0" prefWidth="860.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                            <children>
                                <Label text="⚠️ Detalle de Artículos por Reponer (Stock Menor a 10)" style="-fx-font-weight: bold; -fx-text-fill: #d32f2f; -fx-font-size: 18px;"/>
                                <TableView fx:id="tablaStockCritico" VBox.vgrow="ALWAYS" style="-fx-border-color: #ffcccc; -fx-border-width: 1px; -fx-border-radius: 5px;">
                                    <columns>
                                        <TableColumn fx:id="colCriticoCodigo" text="Código" prefWidth="150.0" />
                                        <TableColumn fx:id="colCriticoNombre" text="Nombre del Artículo" prefWidth="400.0" />
                                        <TableColumn fx:id="colCriticoStock" text="Stock Actual" prefWidth="150.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

            </children>
        </VBox>
    </children>
</AnchorPane>