<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Estadísticas: un selector de período arriba mueve Ventas, Productos y Clientes.
     Inventario (abajo) es la foto de hoy y no depende del período. -->
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="modulo-container"
            style="-fx-background: #F8F9FA; -fx-background-color: #F8F9FA;"
            stylesheets="@../../../../css/nakel.css"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.nakel.frontend.controller.EstadisticasController">

    <VBox spacing="16">
        <padding>
            <Insets top="20" right="20" bottom="24" left="20"/>
        </padding>

        <!-- ENCABEZADO + PERÍODO -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Estadísticas" styleClass="titulo-modulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Período:" styleClass="etiqueta-formulario"/>
            <ComboBox fx:id="cmbPeriodo" prefWidth="190" styleClass="text-field"/>
            <!-- Solo aparece con el período "Por año": lista los años desde la primera venta -->
            <ComboBox fx:id="cmbAnio" prefWidth="110" styleClass="text-field" visibleRowCount="8" visible="false" managed="false"/>
            <Button text="Actualizar" styleClass="btn-secundario" onAction="#actualizar"/>
        </HBox>
        <Label fx:id="lblRango" styleClass="dato-ayuda"/>

        <!-- ================= VENTAS ================= -->
        <Label text="Ventas" styleClass="titulo-seccion"/>

        <HBox spacing="16">
            <VBox styleClass="tarjeta, tarjeta-kpi" HBox.hgrow="ALWAYS">
                <Label fx:id="lblTituloVentas" text="Ventas del período" styleClass="kpi-titulo"/>
                <Label fx:id="lblVentasPeriodo" text="\$ 0,00" styleClass="kpi-valor"/>
                <Label fx:id="lblCantidadPeriodo" text="0 ventas" styleClass="kpi-detalle"/>
                <Label fx:id="lblVariacion" styleClass="kpi-detalle"/>
            </VBox>
            <VBox styleClass="tarjeta, tarjeta-kpi" HBox.hgrow="ALWAYS">
                <Label text="Ticket promedio" styleClass="kpi-titulo"/>
                <Label fx:id="lblTicketPromedio" text="\$ 0,00" styleClass="kpi-valor"/>
                <Label text="Lo que se lleva en promedio cada venta" styleClass="kpi-detalle" wrapText="true"/>
            </VBox>
            <VBox styleClass="tarjeta, tarjeta-kpi" HBox.hgrow="ALWAYS">
                <Label text="Compra más grande" styleClass="kpi-titulo"/>
                <Label fx:id="lblMayorCompra" text="\$ 0,00" styleClass="kpi-valor"/>
                <Label fx:id="lblMayorCompraDetalle" text="-" styleClass="kpi-detalle" wrapText="true"/>
            </VBox>
            <VBox styleClass="tarjeta, tarjeta-kpi" HBox.hgrow="ALWAYS">
                <Label text="Ventas de hoy" styleClass="kpi-titulo"/>
                <Label fx:id="lblVentasHoy" text="\$ 0,00" styleClass="kpi-valor"/>
                <Label fx:id="lblCantidadHoy" text="0 ventas" styleClass="kpi-detalle"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS" minWidth="420">
                <Label fx:id="lblTituloEvolucion" text="Cómo viene la venta" styleClass="titulo-tarjeta"/>
                <StackPane>
                    <BarChart fx:id="chartEvolucion" styleClass="grafico-nakel" legendVisible="false" animated="false"
                              prefHeight="260" minHeight="220" barGap="0" categoryGap="6">
                        <xAxis><CategoryAxis fx:id="ejeEvolucionX" animated="false"/></xAxis>
                        <yAxis><NumberAxis fx:id="ejeEvolucionY" animated="false" forceZeroInRange="true"/></yAxis>
                    </BarChart>
                    <Label fx:id="lblSinEvolucion" text="No hay ventas en este período." styleClass="dato-ayuda" visible="false"/>
                </StackPane>
            </VBox>
            <VBox spacing="6" styleClass="tarjeta" minWidth="320" prefWidth="360" maxWidth="400">
                <Label text="Cómo pagaron" styleClass="titulo-tarjeta"/>
                <StackPane VBox.vgrow="ALWAYS">
                    <PieChart fx:id="chartMediosPago" styleClass="grafico-nakel" animated="false" labelsVisible="false"
                              legendSide="BOTTOM" prefHeight="260" minHeight="220"/>
                    <Label fx:id="lblSinMedios" text="No hay pagos en este período." styleClass="dato-ayuda" visible="false"/>
                </StackPane>
            </VBox>
        </HBox>

        <!-- ================= PRODUCTOS ================= -->
        <Label text="Productos" styleClass="titulo-seccion"/>

        <HBox spacing="16">
            <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS" minWidth="380" prefWidth="400">
                <Label text="Qué rubros se venden más" styleClass="titulo-tarjeta"/>
                <StackPane>
                    <BarChart fx:id="chartCategorias" styleClass="grafico-nakel" legendVisible="false" animated="false"
                              prefHeight="280" minHeight="220" barGap="0" categoryGap="8">
                        <xAxis><NumberAxis fx:id="ejeCategoriasX" animated="false" forceZeroInRange="true"/></xAxis>
                        <yAxis><CategoryAxis fx:id="ejeCategoriasY" animated="false"/></yAxis>
                    </BarChart>
                    <Label fx:id="lblSinCategorias" text="No hay productos vendidos en este período." styleClass="dato-ayuda" visible="false"/>
                </StackPane>
                <Label fx:id="lblOrigenes" styleClass="dato-ayuda" wrapText="true"/>
            </VBox>
            <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS" minWidth="380" prefWidth="400">
                <Label text="Los 10 artículos más vendidos" styleClass="titulo-tarjeta"/>
                <TableView fx:id="tablaTopArticulos" styleClass="tabla-compacta"/>
            </VBox>
        </HBox>

        <!-- ================= CLIENTES ================= -->
        <Label text="Clientes" styleClass="titulo-seccion"/>

        <HBox spacing="16">
            <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS" minWidth="420">
                <Label text="Clientes que más compraron" styleClass="titulo-tarjeta"/>
                <Label text="Total gastado, cuántas veces compró y cuánto se lleva en promedio cada vez." styleClass="dato-ayuda" wrapText="true"/>
                <TableView fx:id="tablaTopClientes" styleClass="tabla-compacta"/>
            </VBox>
            <VBox spacing="10" styleClass="tarjeta" minWidth="300" prefWidth="340" maxWidth="380">
                <Label text="Con nombre o sin nombre" styleClass="titulo-tarjeta"/>
                <VBox spacing="2">
                    <Label text="Clientes con nombre" styleClass="etiqueta-campo"/>
                    <Label fx:id="lblClientesIdentificados" text="\$ 0,00" styleClass="dato-importe"/>
                    <Label fx:id="lblClientesIdentificadosDetalle" styleClass="dato-ayuda"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="Consumidor Final" styleClass="etiqueta-campo"/>
                    <Label fx:id="lblConsumidorFinal" text="\$ 0,00" styleClass="dato-importe"/>
                    <Label fx:id="lblConsumidorFinalDetalle" styleClass="dato-ayuda"/>
                </VBox>
                <Label text="Las ventas a Consumidor Final no entran en el ranking: para saber quién compra más, hay que cargar el cliente al vender."
                       styleClass="dato-ayuda" wrapText="true"/>
            </VBox>
        </HBox>

        <!-- ================= INVENTARIO (hoy) ================= -->
        <Label text="Inventario (al día de hoy)" styleClass="titulo-seccion"/>

        <HBox spacing="16">
            <VBox styleClass="tarjeta, tarjeta-kpi" HBox.hgrow="ALWAYS">
                <Label text="Productos activos" styleClass="kpi-titulo"/>
                <Label fx:id="lblTotalProductos" text="0" styleClass="kpi-valor"/>
                <Label fx:id="lblUnidadesStock" text="0 unidades en stock" styleClass="kpi-detalle"/>
            </VBox>
            <VBox styleClass="tarjeta, tarjeta-kpi" HBox.hgrow="ALWAYS">
                <Label text="Valor de la mercadería" styleClass="kpi-titulo"/>
                <Label fx:id="lblValorStock" text="\$ 0,00" styleClass="kpi-valor"/>
                <Label text="Todo el stock a precio de venta" styleClass="kpi-detalle"/>
            </VBox>
            <VBox styleClass="tarjeta, tarjeta-kpi" HBox.hgrow="ALWAYS">
                <Label text="Por reponer" styleClass="kpi-titulo"/>
                <Label fx:id="lblStockCritico" text="0" styleClass="kpi-valor"/>
                <Label text="Artículos en su stock mínimo o menos" styleClass="kpi-detalle" wrapText="true"/>
            </VBox>
            <VBox styleClass="tarjeta, tarjeta-kpi" HBox.hgrow="ALWAYS">
                <Label text="Vales sin usar" styleClass="kpi-titulo"/>
                <Label fx:id="lblVales" text="\$ 0,00" styleClass="kpi-valor"/>
                <Label fx:id="lblValesDetalle" text="0 vales vigentes" styleClass="kpi-detalle"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS" minWidth="380" prefWidth="400">
                <Label text="Artículos por reponer" styleClass="titulo-tarjeta" style="-fx-text-fill: #C0392B;"/>
                <Label text="Los que están en su stock mínimo o por debajo. El mínimo se carga en cada artículo, desde el Catálogo." styleClass="dato-ayuda" wrapText="true"/>
                <TableView fx:id="tablaStockCritico" styleClass="tabla-compacta"/>
            </VBox>
            <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS" minWidth="380" prefWidth="400">
                <Label text="Mercadería sin movimiento" styleClass="titulo-tarjeta"/>
                <Label fx:id="lblSinMovimiento" styleClass="dato-ayuda" wrapText="true"/>
                <TableView fx:id="tablaSinMovimiento" styleClass="tabla-compacta"/>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
