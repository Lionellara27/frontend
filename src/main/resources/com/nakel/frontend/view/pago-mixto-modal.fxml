<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>

<VBox spacing="15.0" stylesheets="@../../../../css/nakel.css" styleClass="mostrador-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nakel.frontend.controller.PagoMixtoController">
    <children>
        <Label fx:id="lblTotal" text="Total de la Venta: $ 0.00" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <Label fx:id="lblFalta" text="Falta Cobrar: $ 0.00" style="-fx-font-size: 18px; -fx-text-fill: #d32f2f; -fx-font-weight: bold;" />

        <!-- 🔥 NUEVO: SECCIÓN DEL VALE DE CAMBIO -->
        <VBox spacing="5.0">
            <children>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="txtCodigoVale" promptText="Ej: VALE-1234" styleClass="text-field" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAplicarVale" text="🎁 Aplicar Vale" styleClass="btn-secundario" onAction="#aplicarVale" />
                    </children>
                </HBox>
                <Label fx:id="lblDescuentoVale" text="" visible="false" />
            </children>
        </VBox>

        <Separator prefWidth="200.0" />

        <!-- SECCIÓN DE PAGOS NORMALES -->
        <HBox fx:id="cajaAgregar" spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="txtMonto" promptText="Ej: 20000" styleClass="text-field" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cmbMetodo" promptText="Método" styleClass="combo-pago" prefWidth="150.0" />
                <Button fx:id="btnAgregar" text="➕ Agregar" styleClass="btn-secundario" onAction="#agregarPago" />
            </children>
        </HBox>

        <ListView fx:id="listaPagos" prefHeight="120.0" />

        <!-- 🔥 ESTO ES LO QUE FALTABA: EL BOTÓN PARA CERRAR EL MODAL -->
        <Button fx:id="btnConfirmar" text="✅ Confirmar Pago" maxWidth="Infinity" onAction="#confirmarPagos" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10px;"/>

    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>