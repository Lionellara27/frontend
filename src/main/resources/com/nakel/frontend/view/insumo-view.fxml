<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" styleClass="modulo-container"
      stylesheets="@../../../../css/nakel.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nakel.frontend.controller.InsumoController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Label text="Gestión de Insumos y Materia Prima" styleClass="titulo-modulo"/>
    </HBox>

    <!-- 🔥 LA BOTONERA DE FILTROS CORREGIDA Y CON ESTILO CLÁSICO -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscarInsumo" promptText="Buscar insumo..." prefWidth="220" styleClass="input-busqueda"/>

        <!-- 1. Filtrar por Material (Acá volvió el look gris clásico) -->
        <ComboBox fx:id="cmbFiltroMaterial" prefWidth="180" styleClass="text-field"/>

        <!-- 2. Filtrar por Unidad (Acá volvió el look gris clásico) -->
        <ComboBox fx:id="cmbFiltroUnidad" prefWidth="180" styleClass="text-field"/>

        <Button text="Limpiar Filtros" styleClass="btn-secundario" onAction="#limpiarFiltros"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Nuevo Insumo" styleClass="btn-primario" onAction="#abrirModalNuevoInsumo"/>
    </HBox>

    <TableView fx:id="tablaInsumos" VBox.vgrow="ALWAYS" styleClass="tabla-estandar">
        <columns>
            <TableColumn fx:id="colId" text="Cód." prefWidth="50"/>
            <TableColumn fx:id="colDescripcion" text="Descripción (Ej: Cuero Negro, Cierre YKK)" prefWidth="300"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
            <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="100"/>
            <TableColumn fx:id="colCosto" text="Costo Unitario" prefWidth="120"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- 🔥 EL NUEVO PAGINADOR NATIVO DE JAVAFX -->
    <Pagination fx:id="paginadorInsumos" pageCount="1" currentPageIndex="0" VBox.vgrow="NEVER" styleClass="paginador-estandar"/>

</VBox>